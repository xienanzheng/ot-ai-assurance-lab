{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ot-ai-assurance-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ot-aigent-simulation.night-zone.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "ai": {
    "binding": "AI"
  },
  "containers": [
    {
      "class_name": "LabContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LABS",
        "class_name": "LabContainer"
      },
      {
        "name": "SESSIONS",
        "class_name": "SessionRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LabContainer",
        "SessionRegistry"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "VISITORS",
      "database_name": "ot-lab-visitors",
      "database_id": "e131e9e6-48c2-4d33-a34f-61c3cd0dccf0"
    }
  ],
  "ratelimits": [
    {
      "name": "VISITOR_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
