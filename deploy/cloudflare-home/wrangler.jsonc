{
  "$schema": "../cloudflare-live/node_modules/wrangler/config-schema.json",
  "name": "secure-critical-infra-home",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"securecritcticalinfra.dev","custom_domain":true}],
  "assets": {"directory":"../../services/web/dist-home","binding":"ASSETS","run_worker_first":true,"html_handling":"none","not_found_handling":"none"}
}
