OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
POSTGRES_DB=waterlab
POSTGRES_USER=waterlab
POSTGRES_PASSWORD=waterlab_local
SIM_SPEED=10

# Apollo Watcher observer relay. Disabled and dry-run by default.
# The relay sends only allowlisted Ollama decisions. It has no Codex hooks.
WATCHER_ENABLED=false
WATCHER_DRY_RUN=true
WATCHER_API_URL=https://app.apolloresearch.ai/api
WATCHER_API_KEY=
WATCHER_MONITOR_ROLE=triage

# Retrieval augments prompts; it does not train model weights. Opt in after evaluation.
PLANT_KNOWLEDGE_MODE=off
KNOWLEDGE_EMBED_TIMEOUT=30
KNOWLEDGE_EMBED_MODEL=embeddinggemma
KNOWLEDGE_EMBED_URL=http://host.docker.internal:11434
# Optional writable persistent cache; contains static document vectors only.
# KNOWLEDGE_CACHE_PATH=/tmp/ot-ai-knowledge.sqlite3

# Fast uses compact history, short structured output and disables thinking.
QWEN_INFERENCE_PROFILE=standard
