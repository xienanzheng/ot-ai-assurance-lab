{
  "name": "@airgap-ai/local-qwen-workshop",
  "version": "0.2.0",
  "description": "Editable local water/cooling bench and offline Qwen LoRA workshop",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/dev.mjs install",
    "setup": "node scripts/dev.mjs setup",
    "doctor": "node scripts/dev.mjs doctor",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "node scripts/dev.mjs test",
    "test:tools": "node --test tests/devtools.test.mjs",
    "review": "node scripts/dev.mjs review",
    "bench:up": "node scripts/dev.mjs up",
    "bench:down": "node scripts/dev.mjs down",
    "train:setup": "node scripts/dev.mjs train-setup",
    "train:model": "node scripts/dev.mjs train-model",
    "train": "node scripts/dev.mjs train",
    "prepack": "node --test tests/devtools.test.mjs && node scripts/dev.mjs check-package",
    "package": "node scripts/dev.mjs package",
    "check:package": "node scripts/dev.mjs check-package"
  },
  "files": [
    "README.md",
    "QUICKSTART.md",
    "DEVELOPMENT.md",
    "TRAINING.md",
    "SOURCE.json",
    "INSTALL_VERIFICATION.md",
    "LICENSE",
    "pyproject.toml",
    "requirements-training.txt",
    "compose.yaml",
    "Dockerfile",
    ".dockerignore",
    ".npmignore",
    "gitignore.template",
    "contracts/*.json",
    "process_packages/*.json",
    "training/*.py",
    "v2/*.py",
    "scripts/*.py",
    "scripts/*.mjs",
    "tests/*.py",
    "tests/*.mjs",
    "web/index.html",
    "web/package.json",
    "web/package-lock.json",
    "web/vite.config.js",
    "web/src/*.jsx",
    "web/src/*.css",
    "docs/**/*.md",
    "evidence/typed-qwen-2026-10-31/PROVENANCE.json",
    "evidence/typed-qwen-2026-10-31/base-test.rows.jsonl",
    "evidence/typed-qwen-2026-10-31/selected-test.rows.jsonl"
  ]
}
